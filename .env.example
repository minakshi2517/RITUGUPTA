# Local studio login, used when Supabase Auth is not configured.
ADMIN_EMAIL=ritu@studio.local
ADMIN_PASSWORD=replace-with-a-long-password
AUTH_SECRET=replace-with-a-long-random-string

# Public site URL, used for the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When these are set, content is stored in Supabase
# instead of data/store.json on this computer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
